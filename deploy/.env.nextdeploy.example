# NextDeploy panel → App → Environment tab এ copy-paste করুন
# Password/URL বদলে Save → Redeploy

APP_NAME="ISP Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://billing.yourisp.com
APP_TIMEZONE=Asia/Dhaka
ISP_BUNDLE_CSS=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=isp_platform
DB_USERNAME=isp
DB_PASSWORD=change_me_strong_password

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_HEAVY_JOBS_ENABLED=true

SESSION_DRIVER=database
SESSION_DOMAIN=.yourisp.com
TRUSTED_PROXIES=*

# PostgreSQL container (compose substitution)
POSTGRES_DB=isp_platform
POSTGRES_USER=isp
POSTGRES_PASSWORD=change_me_strong_password
