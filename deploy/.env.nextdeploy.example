# NextDeploy panel → App → Environment tab এ copy-paste করুন
# Password/URL বদলে Save → Redeploy

APP_NAME="ISP Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://billing.yourisp.com
APP_TIMEZONE=Asia/Dhaka
ISP_BUNDLE_CSS=true

# Super-admin login (auto-created on deploy via isp:bootstrap-admin)
ISP_ADMIN_EMAIL=admin@isp.local
ISP_ADMIN_PASSWORD=change_me_strong_password

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=isp_platform
# Laravel DB user — can be isp_app even when POSTGRES_USER=isp (auto-created on deploy)
DB_USERNAME=isp_app
DB_PASSWORD=change_me_strong_password

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_HEAVY_JOBS_ENABLED=true

SESSION_DRIVER=database
# Domain live: .yourisp.com | IP:8023 test only: leave empty (SESSION_DOMAIN=)
SESSION_DOMAIN=.yourisp.com
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# PostgreSQL container (compose substitution)
# POSTGRES_USER = superuser created on first volume init (keep isp if volume already exists)
# DB_PASSWORD and POSTGRES_PASSWORD must match
POSTGRES_DB=isp_platform
POSTGRES_USER=isp
POSTGRES_PASSWORD=change_me_strong_password
