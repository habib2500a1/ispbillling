# NextDeploy panel → App → Environment tab এ copy-paste করুন
# প্রতিটি KEY একবারই — duplicate লাইন দেবেন না (শেষেরটা জিতে)

APP_NAME="ISP Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://billing.yourisp.com
APP_TIMEZONE=Asia/Dhaka
ISP_BUNDLE_CSS=true

# Caddy routing backup (compose label on nginx) — panel Domains: nginx:80 ও লাগে
ISP_LANDING_DOMAIN=billing.yourisp.com

# Super-admin — auto-created on deploy (isp:bootstrap-admin)
ISP_ADMIN_EMAIL=admin@isp.local
ISP_ADMIN_PASSWORD=change_me_strong_password

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=isp_platform
DB_USERNAME=isp_app
DB_PASSWORD=change_me_strong_password

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_HEAVY_JOBS_ENABLED=true

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=.yourisp.com
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# PostgreSQL — POSTGRES_USER=isp if pgdata volume already exists with user isp
POSTGRES_DB=isp_platform
POSTGRES_USER=isp
POSTGRES_PASSWORD=change_me_strong_password

# IP:8023 test only (আপাতত): APP_URL=http://SERVER_IP:8023, SESSION_DOMAIN=, SESSION_SECURE_COOKIE=false
