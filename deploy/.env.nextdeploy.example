# =============================================================================
# NextDeploy / Docker — SAFE production .env template
# Panel → Environment tab: copy-paste → secrets বদলান → Redeploy
# প্রতিটি KEY একবারই — duplicate লাইন দেবেন না
# =============================================================================
# NEVER use 127.0.0.1 for REDIS_HOST or DB_HOST in Docker (500 after login)
# =============================================================================

APP_NAME="Radiant Communications Ltd"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://anetbd.com
APP_TIMEZONE=Asia/Dhaka
APP_TIMEZONE_LABEL=BDT
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
ISP_BUNDLE_CSS=true

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (Docker service name = postgres) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=isp_platform
DB_USERNAME=isp_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

POSTGRES_DB=isp_platform
POSTGRES_USER=isp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Redis / queue / session (Docker service name = redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.anetbd.com
SESSION_COOKIE=ispplatform_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_HEAVY_JOBS_ENABLED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Domain / proxy (Cloudflare + Caddy) ---
ISP_LANDING_DOMAIN=anetbd.com
ISP_ADMIN_DOMAIN=
TRUSTED_PROXIES=*
APP_SERVER_EGRESS_IP=

# --- Admin bootstrap (first deploy) ---
ISP_ADMIN_EMAIL=admin@yourisp.com
ISP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ISP_COMPANY_NAME="Your ISP Name"
ISP_COMPANY_TAGLINE="ISP billing, network & customer operations"

# --- Mail (log = no SMTP; production এ SMTP set করুন) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@anetbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Network / MikroTik / OLT ---
BANDWIDTH_COLLECTION_ENABLED=true
NETWORK_AUTO_SUSPEND_ENABLED=true
NETWORK_SERVICE_EXPIRY_ENFORCED=true
NETWORK_OLT_SNMP_POLL_ENABLED=true
MIKROTIK_POLL_STATUS_ENABLED=true
MIKROTIK_CONNECTION_TIMEOUT=30
MIKROTIK_SOCKET_TIMEOUT=120
SYNC_FAST_MODE=true

# --- ONU auto-link (scheduler + horizon container চালু থাকতে হবে) ---
OPTICAL_LEGACY_PORTAL_AUTO_SYNC=true
OPTICAL_AUTO_SYNC_ON_CUSTOMER_SAVE=true
OPTICAL_AUTO_SYNC_ON_CUSTOMER_VIEW=false
OPTICAL_AUTO_FETCH_PPP_SESSIONS=true
OPTICAL_AUTO_LINK_ON_BDCOM_SYNC=true
OPTICAL_AUTO_LINK_ON_OLT_SYNC=true
OPTICAL_MIKROTIK_OPTICAL_BRIDGE=true
OPTICAL_AUTO_PROVISION_ONU=true
OPTICAL_CUSTOMER_SYNC_QUEUE=redis

# --- Aveis RX decode (আপনার OLT firmware অনুযায়ী) ---
AVEIS_RX_MODE=col15_divisor
AVEIS_RX_DIVISOR=57.3

# --- SMS (optional — keys provider থেকে) ---
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_PROVIDER=khudebarta
NOTIFICATIONS_SMS_API_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SECRET_KEY=
NOTIFICATIONS_SMS_SENDER_ID=
KHUDEBARTA_HASH_FORMULA=apikey_secretkey_callerID_toUser_messageContent
SMS_REMINDERS_ENABLED=false

# --- PipraPay (optional) ---
PIPRAPAY_ENABLED=false
PIPRAPAY_API_MODE=redirect
PIPRAPAY_API_KEY=
PIPRAPAY_BASE_URL=https://pay.example.com/api
PIPRAPAY_CURRENCY=BDT
PIPRAPAY_PUBLIC_URL=https://anetbd.com

# --- Legacy portal sync (optional) ---
LEGACY_PORTAL_URL=
LEGACY_PORTAL_USERNAME=
LEGACY_PORTAL_PASSWORD=
LEGACY_PORTAL_DAILY_SYNC_ENABLED=false
LEGACY_PORTAL_DAILY_SYNC_AT=02:30
BILLING_PORTAL_LABEL="Online portal"

# --- Mobile APK (optional — GitHub releases) ---
MOBILE_USE_GITHUB_RELEASES=true
MOBILE_GITHUB_REPO=habib2500a1/ispbillling
MOBILE_RADIANT_GITHUB_TAG=isp-radiant-v2.6.3
MOBILE_MFS_GITHUB_TAG=mfs-verify-v1.0.10
MOBILE_APK_URL=
MOBILE_MFS_VERIFY_APK_URL=
# GitHub PAT — শুধু private repo release download লাগলে; chat/log-এ share করবেন না
GITHUB_TOKEN=
GH_TOKEN=

# --- Call center (optional) ---
CALL_CENTER_ENABLED=false
CALL_CENTER_WEBSIP_ENABLED=false
CALL_CENTER_WEBSIP_AUTO_WSS=true

# --- Bandwidth UI ---
BANDWIDTH_SUBSCRIBER_CHART_POLL_SECONDS=1
BANDWIDTH_SUBSCRIBER_LIVE_MIN_INTERVAL=1

# --- AWS (optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IP:8023 test only: APP_URL=http://SERVER_IP:8023, SESSION_DOMAIN=, SESSION_SECURE_COOKIE=false
