# demo.anetbd.com — আলাদা NextDeploy app + আলাদা database (production data নয়)
# Panel → নতুন app → Environment এ এই ফাইল copy করে password/key বদলান

APP_NAME="ISP Platform Demo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.anetbd.com
APP_TIMEZONE=Asia/Dhaka
APP_TIMEZONE_LABEL=BDT
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
ISP_BUNDLE_CSS=true

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# আলাদা database — production DB নাম/পাসওয়ার্ড ব্যবহার করবেন না
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=isp_platform_demo
DB_USERNAME=isp_app
DB_PASSWORD=CHANGE_ME_DEMO_DB

POSTGRES_DB=isp_platform_demo
POSTGRES_USER=isp
POSTGRES_PASSWORD=CHANGE_ME_DEMO_DB

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=demo_
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.anetbd.com
SESSION_COOKIE=ispplatform_demo_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_HEAVY_JOBS_ENABLED=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

ISP_LANDING_DOMAIN=demo.anetbd.com
ISP_DEFAULT_TENANT_ID=1
INVENTORY_SHOP_TENANT_ID=1
ISP_ADMIN_DOMAIN=

# Full public website (landing + portal + reseller + shop + pay)
PORTAL_ENABLED=true
PORTAL_OTP_ENABLED=false
PORTAL_SIGNUP_ENABLED=true
PORTAL_DEFAULT_PASSWORD=demo123
RESELLER_PORTAL_ENABLED=true
INVENTORY_SHOP_ENABLED=true
HOTSPOT_PORTAL_ENABLED=false

# Demo mode — SMS, MikroTik, RADIUS, WebSIP, auto-suspend বন্ধ
ISP_DEMO_MODE=true
ISP_DEMO_BANNER_LABEL=DEMO
ISP_DEMO_BANNER_MESSAGE=ডেমো সাইট — কোনো আসল গ্রাহক বা পেমেন্ট নেই। MikroTik/SMS বন্ধ।

ISP_DEPLOYMENT_MODE=saas
ISP_LICENSE_ENFORCE=false

TRUSTED_PROXIES=*

# ডেমো লগইন (public URL — শক্তিশালী পাসওয়ার্ড দিন)
ISP_ADMIN_EMAIL=demo@anetbd.com
ISP_ADMIN_PASSWORD=CHANGE_ME_DEMO_ADMIN
ISP_COMPANY_NAME="Demo ISP — anetbd.com"
ISP_COMPANY_TAGLINE="শুধু ডেমো — real data নেই"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@anetbd.com"
MAIL_FROM_NAME="${APP_NAME}"

# নেটওয়ার্ক ইন্টিগ্রেশন বন্ধ (demo safety)
NOTIFICATIONS_SMS_ENABLED=false
SMS_REMINDERS_ENABLED=false
NETWORK_AUTO_SUSPEND_ENABLED=false
NETWORK_SERVICE_EXPIRY_ENFORCED=false
NETWORK_OLT_SNMP_POLL_ENABLED=false
MIKROTIK_POLL_STATUS_ENABLED=false
BANDWIDTH_COLLECTION_ENABLED=false

NOTIFICATIONS_TELEGRAM_ENABLED=false
CALL_CENTER_ENABLED=false
CALL_CENTER_WEBSIP_ENABLED=false
FCM_ENABLED=false

PIPRAPAY_ENABLED=false
LEGACY_PORTAL_DAILY_SYNC_ENABLED=false

# Mobile APK — demo subdomain এ build/sync বন্ধ (anetbd.com production APK ব্যবহার করুন)
MOBILE_USE_GITHUB_RELEASES=false
MOBILE_BUILD_ON_DEPLOY=0

VITE_APP_NAME="${APP_NAME}"

AUTOMATION_RUNNER_LOCK_SECONDS=1800
AUTOMATION_MAX_RUNNER_PROCESSES=1
HORIZON_MAX_PROCESSES=1
