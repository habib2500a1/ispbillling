APP_NAME="ISP Platform SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Production: true merges modular CSS into fewer files (run php artisan isp:build-styles after CSS edits)
ISP_BUNDLE_CSS=false
APP_TIMEZONE=Asia/Dhaka
APP_TIMEZONE_LABEL=BDT

# Fast sync (batch DB, smart MikroTik/OLT) — recommended
SYNC_FAST_MODE=true
BANDWIDTH_POLL_INTERVAL=5
APP_URL=https://billing.example.com
# Comma-separated old domains that must still load this app after a domain change
APP_PREVIOUS_URLS=
# Optional extra hosts (staging, www redirect target, etc.)
ISP_ALLOWED_HOSTS=
PORTAL_ENABLED=true
# Image uploads (logo, subscriber photo): server needs nginx client_max_body_size 20M and PHP upload_max 12M — run scripts/fix-image-upload-limits.sh

# Mobile APK — server-hosted downloads (recommended after deploy)
# public/downloads/*.apk on this server → website links use APP_URL/downloads/*
MOBILE_USE_GITHUB_RELEASES=false
MOBILE_GITHUB_REPO=habib2500a1/ispbillling
# APK auto-build: reads APP_URL from .env after install/deploy (no manual setup)
# Leave MOBILE_APK_URL unset when APK files live in public/downloads/
# MOBILE_RADIANT_GITHUB_TAG=isp-radiant-v2.6.3
# MOBILE_MFS_GITHUB_TAG=mfs-verify-v1.0.4
# Optional GitHub fallback (only used when local APK missing):
# MOBILE_APK_URL=https://github.com/habib2500a1/ispbillling/releases/download/isp-radiant-v2.6.3/isp-radiant.apk
# MOBILE_MFS_VERIFY_APK_URL=https://github.com/habib2500a1/ispbillling/releases/download/mfs-verify-v1.0.4/isp-mfs-verify.apk
# Build APKs on each deploy (needs Flutter on server — or use GitHub Actions mobile-apks.yml):
# MOBILE_BUILD_ON_DEPLOY=1
# Firebase Cloud Messaging (customer/technician push)
FCM_ENABLED=false
FCM_SERVER_KEY=
# GitHub — push + optional APK releases (./scripts/gh-auth-with-token.sh)
# GITHUB_TOKEN=github_pat_xxxxxxxx
# GH_TOKEN=github_pat_xxxxxxxx

# Public site + staff panel hostnames
ISP_LANDING_DOMAIN=billing.example.com
# Apex host tenant (anetbd.com, bill.flixbd.xyz) when not using subdomain routing
ISP_DEFAULT_TENANT_ID=1
INVENTORY_SHOP_TENANT_ID=1
# Leave empty — staff panel at APP_URL/admin (e.g. billing.example.com/admin)
ISP_ADMIN_DOMAIN=
# First deploy: super-admin is created automatically (isp:post-deploy / isp:bootstrap-admin)
ISP_ADMIN_EMAIL=admin@isp.local
ISP_ADMIN_PASSWORD=changeme123!
# Cloudflare / reverse proxy
# Comma-separated proxy IPs (load balancer / CDN). Leave empty in local dev to trust all.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Comma-separated channels, e.g. single,sentry (requires SENTRY_LARAVEL_DSN)
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry (optional — set DSN in production; add "sentry" to LOG_STACK)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
#
# Docker/PostgreSQL production example:
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=isp_platform
# DB_USERNAME=isp
# DB_PASSWORD=change_me

SESSION_DRIVER=database
# Idle session timeout (minutes). 43200 = 30 days. Use with "Remember me" on login forms.
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.billing.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production Docker: CACHE_STORE=redis (do not use "failover" — unsupported on Laravel 11)
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# bKash tokenized checkout (sandbox): https://developer.bka.sh/
# Super-admins can override the following from Filament: System → Integrations (stored encrypted in DB).
BKASH_ENABLED=false
# tokenized_web | personal (PipraPay-style Send Money + TrxID + SMS verify)
BKASH_GATEWAY_TYPE=tokenized_web
BKASH_PERSONAL_NUMBER=
# BKASH_PERSONAL_AUTO_VERIFY=true when MFS SMS ingest is on
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_HTTP_TIMEOUT=30

SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

NAGAD_ENABLED=false
# api | personal
NAGAD_GATEWAY_TYPE=api
NAGAD_PERSONAL_NUMBER=
NAGAD_SANDBOX=true
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# PipraPay v3 — https://piprapay.readme.io/reference/overview
PIPRAPAY_ENABLED=false
PIPRAPAY_API_MODE=redirect
PIPRAPAY_API_KEY=
# Panel “Base URL”, e.g. https://pay.flixbd.xyz/api
PIPRAPAY_BASE_URL=https://pay.flixbd.xyz/api
# Must be a DOMAIN (PipraPay rejects bare IPs). Same server as APP_URL:
# PIPRAPAY_PUBLIC_URL=http://isp.flixbd.xyz
# or quick fix: PIPRAPAY_PUBLIC_URL=http://72-18-215-205.sslip.io
PIPRAPAY_PUBLIC_URL=
PIPRAPAY_CURRENCY=BDT
PIPRAPAY_HTTP_TIMEOUT=30

RESELLER_PORTAL_ENABLED=true

# Public bill payment (/pay) — client code + OTP + bKash without portal login
BILL_PAY_OTP_ENABLED=true
BILL_PAY_OTP_TTL_SECONDS=600
BILL_PAY_OTP_DIGITS=6
BILL_PAY_OTP_LOG_ONLY=false
BILL_PAY_ALLOW_PARTIAL=true
BILL_PAY_MIN_AMOUNT=10
BILL_PAY_WALLET_TOPUP=true
BILL_PAY_WALLET_TOPUP_MIN=100
BILL_PAY_LINK_TTL_DAYS=7

# SMS — KhudeBarta (Softifybd) https://portal.khudebarta.com/Softifybd/#/technical-details
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_PROVIDER=khudebarta
NOTIFICATIONS_SMS_API_URL=http://portal.khudebarta.com:3775/sendtext
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SECRET_KEY=
NOTIFICATIONS_SMS_SENDER_ID=
KHUDEBARTA_HASH_FORMULA=apikey_secretkey_callerID_toUser_messageContent
# KHUDEBARTA_HASH_UPPERCASE=false
# KHUDEBARTA_DLR_URL=https://your-domain/webhooks/sms/khudebarta/dlr

# Ops alerts — queue failures, SMS health (Telegram recommended)
# NOTIFICATIONS_TELEGRAM_ENABLED=true
# NOTIFICATIONS_TELEGRAM_BOT_TOKEN=
# NOTIFICATIONS_TELEGRAM_OPS_CHAT_ID=
ALERTS_QUEUE_HEALTH_ENABLED=true
ALERTS_QUEUE_FAILED_THRESHOLD=5
ALERTS_QUEUE_FAILED_MINUTES=15
# ALERTS_OPS_EMAIL=ops@yourisp.com
# ALERTS_OPS_SMS_PHONE=8801XXXXXXXXX

# Public bill pay — clients must pay full invoice due (no partial manual amount)
# BILL_PAY_ALLOW_PARTIAL=false

# Personal MFS SMS forwarder (PipraPay-style) — Android app posts parsed bKash/Nagad SMS
# APP_URL must be your public HTTPS host (checkout + API base URLs derive from it).
MFS_SMS_INGEST_ENABLED=false
MFS_SMS_DEVICE_API_KEY=
MFS_SMS_REQUIRE_APPROVED=true
# MFS_SMS_AUTO_APPROVE=false

# Rocket (DBBL) — customer pays merchant Rocket number + enters TrxID on /rocket/pay
ROCKET_ENABLED=false
ROCKET_MERCHANT_NUMBER=
ROCKET_MERCHANT_NAME=
ROCKET_WEBHOOK_SECRET=
# ROCKET_PAYMENT_INSTRUCTIONS=

# Queue heavy jobs (MikroTik poll) — requires queue:work or Horizon
# true + Redis + Horizon — keeps MikroTik/OLT jobs off PHP-FPM (recommended production)
QUEUE_HEAVY_JOBS_ENABLED=true

# Reseller commission SMS/email
NOTIFICATIONS_RESELLER_COMMISSION=true
NOTIFICATIONS_RESELLER_PAYOUT=true

# Due-date reminders (email + log). Super-admins can override in Filament → System → Integrations.
SMS_REMINDERS_ENABLED=false
SMS_REMINDERS_DAYS=3

# Row-level tenancy: use Filament → System → Tenants. Set users.tenant_id for isp-admin; super-admin may leave null to see all.
# Optional: ISP_TENANT_BASE_DOMAIN=isp.example.com → staff log in at https://{tenant-slug}.isp.example.com/admin
# Super-admins can also set this from Filament → System → Integrations (stored in DB; falls back to this .env value when cleared).
ISP_TENANT_BASE_DOMAIN=

# Demo / training site (purple banner; disables SMS, MikroTik push, WebSIP). See docs/DEMO_MODE.md
ISP_DEMO_MODE=false
# ISP_DEMO_BANNER_LABEL=DEMO
# ISP_DEMO_BANNER_MESSAGE=Demo mode — no real SMS or router changes.

# Deployment: rent (SaaS) vs sell (on-premise). See docs/PLATFORM_RENT_SELL_SECURITY.md
# Rent — your server (e.g. bill.flixbd.xyz): saas + no license enforce
ISP_DEPLOYMENT_MODE=saas
ISP_LICENSE_ENFORCE=false
ISP_LICENSE_KEY=
# Sell — customer server: on_premise + enforce + key from: php artisan isp:issue-license their.domain.com
# ISP_DEPLOYMENT_MODE=on_premise
# ISP_LICENSE_ENFORCE=true
# ISP_LICENSE_PUBLIC_KEY_PATH=resources/license/public.pem
# ISP_LICENSE_PRIVATE_KEY_PATH=storage/license/private.pem

# Network automation (MikroTik / RADIUS / OLT stubs). See config/network.php.
NETWORK_PROVISIONER_DRIVER=null
NETWORK_MIKROTIK_PUSH_ENABLED=true
# When true, saving a customer still pushes /ppp/secret over RouterOS API if tenant has enabled MikroTik servers, even when NETWORK_PROVISIONER_DRIVER is null (RADIUS-only uses API for PPP; RADIUS stubs stay separate).
NETWORK_MIKROTIK_ALWAYS_PUSH_PPP_ON_CUSTOMER_SAVE=true
NETWORK_RADIUS_PUSH_ENABLED=true
NETWORK_AUTO_SUSPEND_ENABLED=true
NETWORK_SERVICE_EXPIRY_ENFORCED=true
# MIKROTIK_API_URL=
# MIKROTIK_API_USER=
# MIKROTIK_API_PASSWORD=

# Bandwidth monitor: MikroTik API + FreeRADIUS radacct merge. See config/bandwidth.php, config/radius.php.
BANDWIDTH_COLLECTION_ENABLED=true
BANDWIDTH_POLL_INTERVAL=5
# Scheduler safety — one isp:run-automatic-processes at a time (prevents 502 from PHP-FPM exhaustion)
# Scheduler stability — prevents stacked MikroTik/OLT jobs from hanging the server
AUTOMATION_RUNNER_LOCK_SECONDS=1800
AUTOMATION_MAX_RUNNER_PROCESSES=1
AUTOMATION_MIN_RUNNER_KILL_SECONDS=90
AUTOMATION_STALE_RUNNER_SECONDS=600
HORIZON_MAX_PROCESSES=2
LOG_PRUNE_MAX_BYTES=50000000
LOG_PRUNE_KEEP_BYTES=2000000
# FreeRADIUS accounting DB (radacct) — enables dual sync with API on Bandwidth monitor.
RADIUS_ACCOUNTING_ENABLED=false
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_DATABASE=radius
RADIUS_DB_USERNAME=radius
RADIUS_DB_PASSWORD=
RADIUS_MERGE_WITH_API=true
RADIUS_INTERIM_INTERVAL=300
RADIUS_MAX_ACTIVE_SESSIONS=10000
# RADIUS user admin UI (radcheck / radusergroup CRUD in Filament → Network → RADIUS users)
RADIUS_ADMIN_ENABLED=false
RADIUS_RADCHECK_TABLE=radcheck
RADIUS_RADREPLY_TABLE=radreply
RADIUS_USERGROUP_TABLE=radusergroup

# WhatsApp two-way bot (Meta webhook → /api/webhooks/whatsapp)
WHATSAPP_BOT_ENABLED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BOT_DEFAULT_DEPARTMENT=billing
WHATSAPP_BOT_SEND_PAY_LINKS=true

# FUP / abuse auto-enforcement (suspend or throttle via RADIUS)
BANDWIDTH_ABUSE_AUTO_ENFORCE=false
BANDWIDTH_ABUSE_SUSPEND_DAILY=false
NETFLOW_ABUSE_EVAL_ENABLED=true
NETFLOW_ABUSE_THRESHOLD_GB=200
NETFLOW_ABUSE_ACTION=alert

# Accounting: auto journal on invoice issue
ACCOUNTING_AUTO_POST_INVOICES=false

# Subscriber ID: automatic on create (0=manual, 1=automatic). Panel: Company setup → Customer ID.
SUBSCRIBER_AUTO_GENERATE_CODE=1
# Format when automatic: prefixed_monthly | numeric | prefix_sequential | secret_as_code
SUBSCRIBER_CODE_FORMAT=prefixed_monthly
SUBSCRIBER_CODE_PREFIX=CUST
SUBSCRIBER_NUMERIC_START=10001
SUBSCRIBER_IMPORT_SET_RADIUS_USERNAME=true
SUBSCRIBER_AUTO_IMPORT_MIKROTIK_SECRETS=false

# MikroTik multi-server panel (Filament → Network → MikroTik). See config/mikrotik.php.
MIKROTIK_POLL_STATUS_ENABLED=true
# Hourly scheduler: isp:mikrotik-fetch-details (stores API snapshot in meta). API-heavy — keep false unless needed.
MIKROTIK_FETCH_DETAILS_POLL_ENABLED=false
# Fleet routers with 300+ PPP over WAN: use 30 / 120 (defaults in config/mikrotik.php)
MIKROTIK_CONNECTION_TIMEOUT=30
MIKROTIK_SOCKET_TIMEOUT=120
MIKROTIK_API_MAX_ATTEMPTS=3
MIKROTIK_RETRY_DELAY_MS=400
MIKROTIK_CIRCUIT_BREAKER_ENABLED=true
MIKROTIK_CIRCUIT_FAILURE_THRESHOLD=3
MIKROTIK_CIRCUIT_OPEN_SECONDS=120

# ONU portal status: isp:sync-onu-status-from-meta copies devices.meta → onu_oper_status / offline_reason.
ONU_META_SYNC_ENABLED=true

# Billing: invoice number prefix (year infix optional). See config/billing.php.
BILLING_INVOICE_PREFIX=INV
BILLING_INVOICE_YEAR_INFIX=true
BILLING_AUTO_APPLY_PROMOTIONAL_OFFERS=true
# SNMP (OLT "Test SNMP" in Filament). Requires PHP ext-snmp on the app server, e.g.:
#   sudo apt install php8.3-snmp && sudo systemctl restart php8.3-fpm
#   php -m | grep -i snmp
# net-snmp / PHP ext-snmp (see https://github.com/net-snmp/net-snmp)
# apt install snmp php8.3-snmp  |  snmpwalk -v2c -c COMMUNITY OLT_IP 1.3.6.1.2.1.1.1.0
SNMP_TIMEOUT_US=2000000
SNMP_RETRIES=1
SNMP_USE_PLAIN_VALUES=true
# Public IP of bill panel server — shown in SNMP test errors for OLT ACL whitelist
APP_SERVER_EGRESS_IP=

# PPTP to POP for OLT SNMP (systemd isp-olt-pptp; credentials in /etc/ppp/chap-secrets)
OLT_PPTP_SERVER=103.29.127.228
OLT_PPTP_SUBNET=103.29.127.0/24

# Network intelligence: OLT SNMP poll (isp:poll-olt-intelligence) + NetFlow ingest
NETWORK_OLT_SNMP_POLL_ENABLED=true
OPTICAL_MONITORING_ENABLED=true
# Aveis receive power: col15_divisor (default, OLT “Receive Power”) | negative_tenth | skip
AVEIS_RX_MODE=col15_divisor
AVEIS_RX_DIVISOR=57.3
AVEIS_ONU_RX_COLUMN=15
# Optional Aveis ONU table columns (0 = disabled). Find via: snmpwalk -v2c -c COMMUNITY OLT_IP 1.3.6.1.4.1.50224.3.3.2.1
# AVEIS_ONU_TX_COLUMN=16
# AVEIS_ONU_TEMP_COLUMN=18
# AVEIS_ONU_VOLTAGE_COLUMN=19
# AVEIS_ONU_DISTANCE_COLUMN=14
# AVEIS_VOLTAGE_MODE=hundredth_v

# VSOL / Ecom / C-DATA — set after snmpwalk (firmware-specific)
# VSOL_SNMP_ONU_DESC_OID=
# VSOL_SNMP_ONU_STATUS_OID=
# VSOL_SNMP_ONU_MAC_OID=
# VSOL_SNMP_ONU_RX_OID=
# VSOL_SNMP_ONU_TX_OID=
# VSOL_SNMP_ONU_TEMP_OID=
# VSOL_SNMP_ONU_VOLTAGE_OID=
# VSOL_SNMP_ONU_SN_OID=
# VSOL_OPTICAL_SCALE=10

# BDCOM ONU temperature / voltage (defaults match NMS-EPON-ONU MIB; override if needed)
# BDCOM_ONU_TEMP_OID=1.3.6.1.4.1.3320.101.10.5.1.2
# BDCOM_ONU_VOLTAGE_OID=1.3.6.1.4.1.3320.101.10.5.1.3

# ZTE / Fiberhome / Nokia / Raisecom / C-DATA — same keys as VSOL (fallback to VSOL_* if unset)
# ZTE_SNMP_ONU_RX_OID=
# FIBERHOME_SNMP_ONU_RX_OID=
# CDATA_SNMP_ONU_RX_OID=
# NOKIA_SNMP_ONU_RX_OID=
# RAISECOM_SNMP_ONU_RX_OID=

# Auto-detect OLT type from SNMP sysDescr on poll
OLT_AUTO_DRIVER_FROM_SNMP=true

# Call center (Sheba-Fi parity — webhook ingest + optional WebSIP)
CALL_CENTER_ENABLED=true
CALL_CENTER_DRIVER=log_only
CALL_CENTER_WEBHOOK_SECRET=
CALL_CENTER_AUTO_TICKET_ON_MISSED=true
CALL_CENTER_WEBSIP_ENABLED=false
# Auto-try wss://{sip_domain}:7443/ws etc. when WSS URI field is empty (same login as PortSIP)
CALL_CENTER_WEBSIP_AUTO_WSS=true
CALL_CENTER_VOICE_SMS_PREFIX="[Voice] "
# Voice call (IVR) when SMS template has "Voice call enabled" or campaigns send_voice=true
VOICE_CALL_ENABLED=false
VOICE_CALL_DRIVER=log_only
VOICE_CALL_WEBHOOK_URL=
VOICE_CALL_WEBHOOK_SECRET=
# BDWebs / PortSIP (optional — php artisan isp:apply-bdwebs-sip)
# BDWEBS_SIP_DOMAIN=sip17.bdwebs.com
# BDWEBS_SIP_SERVER=202.40.176.2
# BDWEBS_SIP_USERNAME=
# BDWEBS_SIP_PASSWORD=
# BDWEBS_WSS_URI=wss://sip17.bdwebs.com:7443/ws

# Legacy online billing portal (pay.anetbd.com) — import & daily sync
# ISPTrack migration (isp:export-isptrack-json / isp:import-isptrack)
ISPTRACK_DB_HOST=127.0.0.1
ISPTRACK_DB_PORT=3306
ISPTRACK_DB_DATABASE=isptrack
ISPTRACK_DB_USERNAME=root
ISPTRACK_DB_PASSWORD=
ISPTRACK_DEFAULT_AREA="Main coverage"
ISPTRACK_DEFAULT_AREA_CODE=MAIN

LEGACY_PORTAL_URL=https://pay.anetbd.com
LEGACY_PORTAL_USERNAME=admin
LEGACY_PORTAL_PASSWORD=
LEGACY_PORTAL_DAILY_SYNC_ENABLED=true
LEGACY_PORTAL_DAILY_SYNC_AT=02:30
LEGACY_PORTAL_DAILY_SYNC_IMPORT_BATCH=100
LEGACY_PORTAL_SYNC_VOID_ORPHANS=true
BILLING_PORTAL_LABEL="Online portal"
# Collection desk default filter: desk | legacy_portal | all
LEGACY_PORTAL_COLLECTION_REPORT_SOURCE=legacy_portal

# Legacy portal optical: auto OLT pull + PPP login link on save/view
OPTICAL_LEGACY_PORTAL_AUTO_SYNC=true
OPTICAL_AUTO_SYNC_ON_CUSTOMER_VIEW=true
OPTICAL_AUTO_SYNC_ON_CUSTOMER_SAVE=true
OPTICAL_LEGACY_PORTAL_INVENTORY_MAX_AGE=180
OPTICAL_AUTO_SYNC_OLT_ON_MAC_LOOKUP=true
# sync = auto runs without queue:work; redis = needs Horizon/queue worker
OPTICAL_CUSTOMER_SYNC_QUEUE=sync
OPTICAL_MIKROTIK_OPTICAL_BRIDGE=true
OPTICAL_WEBHOOK_SECRET=
OPTICAL_WEBHOOK_AUTO_CREATE=true
# RX bands (dBm): excellent -8 to -15, good to -22, weak to -27, critical below -27
OPTICAL_RX_EXCELLENT_MAX=-8
OPTICAL_RX_EXCELLENT_MIN=-15
OPTICAL_RX_GOOD_MIN=-22
OPTICAL_RX_WEAK_MIN=-27
# Laser high: alert when RX/TX exceeds these (short fibre / strong laser)
OPTICAL_RX_HIGH_WARN_ABOVE=-8
OPTICAL_TX_MIN=0.5
OPTICAL_TX_MAX=5.5
OPTICAL_TX_HIGH_WARN_ABOVE=5.5
OPTICAL_ALERT_ON_HIGH_RX=true
OPTICAL_ALERT_ON_HIGH_TX=true
OPTICAL_AUTO_TICKET=true
NETFLOW_ENABLED=true
NETFLOW_WEBHOOK_SECRET=
NETFLOW_RETENTION_DAYS=7

# Customer portal: optional OTP after password. Manage in Filament → System → Customer portal (isp-admin / isp-manager / super-admin).
PORTAL_OTP_ENABLED=false
PORTAL_OTP_LOG_ONLY=false
PORTAL_OTP_TTL_SECONDS=600
PORTAL_OTP_DIGITS=6

# External ticket ingest (WhatsApp / call-center bridge). POST /api/webhooks/support-ticket-ingest with header X-ISP-Webhook-Secret.
ISP_SUPPORT_WEBHOOK_SECRET=

# Generate all webhook/device secrets quickly:
# php artisan isp:generate-webhook-secrets --write

# Platform backup (admin → System → Backup & restore). Requires pg_dump/pg_restore on server for PostgreSQL.
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_ARCHIVES=20
BACKUP_INCLUDE_STORAGE_APP=true
